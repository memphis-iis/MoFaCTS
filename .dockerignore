# Dependency directories - will be installed fresh in Docker
# Includes generated Meteor package-owned installations.
**/node_modules/

# Outputs regenerated by Meteor/package installation, not captured source inputs.
mofacts/packages/ostrio-files/.npm/
# prepareWebGazerAssets.cjs regenerates these from locked WebGazer + source licenses.
mofacts/public/webgazer/
# prepareMediaPipeAssets.cjs regenerates WASM; keep the source-owned model/notices.
mofacts/public/mediapipe/wasm/

# Rspack compiler outputs; their scripts, configuration and lockfiles stay captured.
mofacts/_build/
mofacts/_build-*/
mofacts/public/build-assets/
mofacts/public/build-assets-*/
mofacts/public/build-chunks/
mofacts/public/build-chunks-*/
mofacts/private/build-assets/
mofacts/private/build-assets-*/
mofacts/private/build-chunks/
mofacts/private/build-chunks-*/
mofacts/.rsdoctor/
mofacts/public/.rsdoctor/
mofacts/private/.rsdoctor/

# Meteor local build cache (NEVER include this!)
mofacts/.meteor/local/
.meteor/local/

# Logs
*.log
npm-debug.log*

# IDE
.vscode/
.idea/

# Git
.git/
.gitignore

# OS
.DS_Store
Thumbs.db

# Testing
mofacts/tests/*
!mofacts/tests/changeStreamsQualificationContract.ts
!mofacts/tests/logComparison.test.js

# Documentation (optional, can remove if needed in image)
docs/
docs_dev/

# Local and deploy settings. Runtime settings are copied to servers separately
# and mounted into containers; they must never enter image build context.
mofacts/settings.json
settings.json
deploy/settings*.json

# Private deploy/runtime state
deploy/.env*
deploy/.gemini/
deploy/local-data/
deploy/local-dev/
deploy/local-hotfix/
deploy/local-build/

# Build artifacts
*.pyc
__pycache__/
