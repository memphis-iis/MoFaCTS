mofacts.example.org {
	encode zstd gzip

	header Strict-Transport-Security "max-age=31536000"
	# Replace both public-hostname occurrences for this installation. The deferred
	# default preserves stricter CSP headers owned by individual app endpoints.
	header ?Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://www.youtube.com/iframe_api https://www.youtube.com/s/player/; style-src 'self' https://fonts.googleapis.com; style-src-attr 'unsafe-inline'; img-src 'self' data: blob: https://d2xvti2irp4c7t.cloudfront.net https://i.ytimg.com/vi/ https://upload.wikimedia.org; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' wss://mofacts.example.org https://openrouter.ai/api/v1/ https://en.wikipedia.org/w/api.php https://commons.wikimedia.org/w/api.php https://upload.wikimedia.org https://noembed.com/embed https://cdn.plyr.io/3.8.4/plyr.svg; media-src 'self' blob: data: https://d2xvti2irp4c7t.cloudfront.net https://cloud.google.com https://docs.cloud.google.com; worker-src 'self' blob:; frame-src 'self' https://www.youtube-nocookie.com https://d2xvti2irp4c7t.cloudfront.net https://plot.ly https://cran.r-project.org; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'"

	reverse_proxy 127.0.0.1:3000 {
		header_up Host {host}
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}
}
