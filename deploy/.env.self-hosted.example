DOCKER_REGISTRY=mofacts-local
IMAGE_NAME=mofacts-mini
IMAGE_TAG=v0.1.0-alpha.1

ROOT_URL=https://mofacts.example.org
MOFACTS_HTTP_BIND=127.0.0.1:3000
PORT=3000

METEOR_SETTINGS_HOST_PATH=./settings.self-hosted.example.json
MOFACTS_BACKUP_HOST_PATH=/backups/mofacts
MOFACTS_ENV_FILE_HOST_PATH=./.env.self-hosted

EXPECTED_MONGO_DB_NAME=MoFACT-meteor3
MOFACTS_SELF_HOSTED=true
MOFACTS_MONGO_APP_DATABASE=MoFACT-meteor3
MONGO_INITDB_ROOT_USERNAME=mofacts_root
MONGO_INITDB_ROOT_PASSWORD=replace-with-a-long-random-root-password
MOFACTS_MONGO_APP_USERNAME=mofacts_app
MOFACTS_MONGO_APP_PASSWORD=replace-with-a-long-random-app-password
MONGO_URL='mongodb://mofacts_app:replace-with-url-encoded-app-password@mongodb:27017/MoFACT-meteor3?authSource=MoFACT-meteor3&replicaSet=mofacts-rs'
METEOR_REACTIVITY_ORDER=polling
DDP_TRANSPORT=sockjs
MOFACTS_MONGO_REPLICA_SET_NAME=mofacts-rs
MOFACTS_MONGO_REPLICA_SET_MEMBER=mongodb:27017
MONGO_REPLICA_SET_KEYFILE_HOST_PATH=/etc/mofacts/mongodb-keyfile

MOFACTS_REDIS_PASSWORD=replace-with-at-least-32-url-safe-random-characters
MOFACTS_SECURITY_AUDIT_INGEST_SECRET=replace-with-at-least-32-random-characters
